            <uipath:output name="eventIdentifier" type="string" source="=js:(vars.mainEventSubprocessResponse != null &#38;&#38; vars.mainEventSubprocessResponse.eventId != null) ? vars.mainEventSubprocessResponse.eventId : ((vars.mainEventSubprocessResponse != null &#38;&#38; vars.mainEventSubprocessResponse.incitingEventId != null) ? vars.mainEventSubprocessResponse.incitingEventId : ((vars.mainEventSubprocessResponse != null &#38;&#38; vars.mainEventSubprocessResponse.incitingEvent != null) ? vars.mainEventSubprocessResponse.incitingEvent : ((vars.mainEventSubprocessResponse != null &#38;&#38; vars.mainEventSubprocessResponse.event != null) ? vars.mainEventSubprocessResponse.event : &#34;&#34;)))" var="EventSubProcessEventIdentifier" custom="true" internal="true" />
            <uipath:output name="latestEventParams" type="json" var="EventSubProcessLatestEventParams" custom="true" internal="true"><![CDATA[=js:({ ...(((vars.mainEventSubprocessResponse != null && vars.mainEventSubprocessResponse.connectorRuleId != null) ? { "connectorIds": [vars.mainEventSubprocessResponse.connectorRuleId] } : {})), ...(((vars.mainEventSubprocessResponse != null && vars.mainEventSubprocessResponse.taskName != null) ? { "taskName": vars.mainEventSubprocessResponse.taskName } : {})), ...(((vars.mainEventSubprocessResponse != null && vars.mainEventSubprocessResponse.taskNames != null) ? { "taskNames": vars.mainEventSubprocessResponse.taskNames } : {})), ...(((vars.mainEventSubprocessResponse != null && vars.mainEventSubprocessResponse.stageNames != null) ? { "stageNames": vars.mainEventSubprocessResponse.stageNames } : {})) })]]></uipath:output>
