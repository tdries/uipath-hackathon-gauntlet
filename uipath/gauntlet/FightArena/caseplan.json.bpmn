            <uipath:context>
              <uipath:inputSchema type="jsonSchema"><![CDATA[{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","properties":{"caseRulesDecisions":{"type":"object"},"caseCurrentExecutionState":{"type":"object"}},"required":[]}]]></uipath:inputSchema>
            </uipath:context>
            <uipath:input name="caseManagerInput" type="json" target="body"><![CDATA[{"caseRulesDecisions":"=js:(vars.caseRulesDecisions)","caseCurrentExecutionState":"=js:({ \"version\": 1, \"eventIdentifier\": vars.EventSubProcessEventIdentifier, \"event\": { \"type\": vars.EventSubProcessLatestEventType, \"parameters\": vars.EventSubProcessLatestEventParams, \"isExternal\": (vars.EventSubProcessLatestEventType == \"CaseEntered\" || vars.EventSubProcessLatestEventType == \"TaskCompleted\") ? false : true }, \"state\": { ...vars.caseState, \"vars\": { \"Pick persona + scenario\": {  }, \"Call MetroBank CSR\": {  }, \"Call the Referee (Judge)\": {  }, \"Persist fight to Test Cloud\": {  }, \"Received event params\": { \"response\": (vars.mainEventSubprocessResponse.connectorResponse) } } } })"}]]></uipath:input>
