              <uipath:inputSchema type="jsonSchema"><![CDATA[{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","properties":{"caseDeterministicRules":{"type":"object"},"caseCurrentExecutionState":{"type":"object"}},"required":[]}]]></uipath:inputSchema>
            </uipath:context>
            <uipath:input name="caseManagerInput" type="json" target="body"><![CDATA[{"caseDeterministicRules":{"case":{"completionConditions":[]},"stages":[{"name":"Matchmaking","entryConditions":[],"exitConditions":[],"completionConditions":[],"tasks":[]},{"name":"Negotiating","entryConditions":[],"exitConditions":[],"completionConditions":[],"tasks":[]},{"name":"Verdict","entryConditions":[],"exitConditions":[],"completionConditions":[],"tasks":[]},{"name":"Archived","entryConditions":[],"exitConditions":[],"completionConditions":[],"tasks":[]}],"version":1},"caseCurrentExecutionState":"=js:({ \"version\": 1, \"eventIdentifier\": vars.EventSubProcessEventIdentifier, \"event\": { \"type\": vars.EventSubProcessLatestEventType, \"parameters\": vars.EventSubProcessLatestEventParams, \"isExternal\": (vars.EventSubProcessLatestEventType == \"CaseEntered\" || vars.EventSubProcessLatestEventType == \"TaskCompleted\") ? false : true }, \"state\": { ...vars.caseState, \"vars\": { \"Pick persona + scenario\": {  }, \"Call MetroBank CSR\": {  }, \"Call the Referee (Judge)\": {  }, \"Persist fight to Test Cloud\": {  }, \"Received event params\": { \"response\": (vars.mainEventSubprocessResponse.connectorResponse) } } } })"}]]></uipath:input>
            <uipath:output name="caseRulesDecisions" type="json" source="=result" var="caseRulesDecisions" custom="true" />
