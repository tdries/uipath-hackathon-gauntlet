      </bpmn:serviceTask>
      <bpmn:endEvent id="endCancelTaskLoopNode">
        <bpmn:incoming>edge_loopExclusiveGateway-endCancelTaskLoopNode</bpmn:incoming>
        <bpmn:incoming>edge_CancelTasksHandlerNode-endCancelTaskLoopNode</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:inclusiveGateway id="eventSubprocessStagesEnteredInclusiveGateway">
        <bpmn:incoming>edge_eventSubprocessSLAInclusiveGateway-eventSubprocessStagesEnteredInclusiveGateway</bpmn:incoming>
